# Copy to .env and change the values. Never commit .env.
POSTGRES_DB=vela
POSTGRES_USER=vela_owner
POSTGRES_PASSWORD=change-me-owner
VELA_API_DB_PASSWORD=change-me-api
DATABASE_URL=postgresql+psycopg://vela_api:change-me-api@db:5432/vela

JWT_SECRET=change-me-long-random-string
TZ=America/Mexico_City

# Local LLM (Ollama runs on Windows, outside Docker)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
WHISPER_MODEL=small

# Public URL printed by cloudflared (used for CORS / cookies)
PUBLIC_BASE_URL=http://localhost:8080
