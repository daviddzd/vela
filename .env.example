# Copy to .env and change the values. Never commit .env.
POSTGRES_DB=vela
POSTGRES_USER=vela_owner
POSTGRES_PASSWORD=change-me-owner
VELA_API_DB_PASSWORD=change-me-api
# API and worker connect as vela_api (row-level security applies). Same password as above.
DATABASE_URL=postgresql+psycopg://vela_api:change-me-api@db:5432/vela
# Migrations (service `migrate`) connect as the table owner, built from POSTGRES_* in docker-compose.yml.

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-long-random-string
TZ=America/Mexico_City
# Dispatch policy: nearest | risk_priority | risk_plus_live_traffic (default) | human_dispatcher
DISPATCH_POLICY=risk_plus_live_traffic

# Local LLM (Ollama runs on Windows, outside Docker)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
WHISPER_MODEL=small

# Public URL printed by cloudflared (used for CORS / cookies)
PUBLIC_BASE_URL=http://localhost:8080
