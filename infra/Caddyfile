# Public entry point on :8080. FastAPI already uses the /api and /ws prefixes,
# so paths are forwarded unchanged (no prefix stripping).
{
	admin off
	servers {
		# cloudflared (on this laptop) reaches Caddy from a private Docker/host address. Trust
		# X-Forwarded-* only from private ranges, so the API sees the real scheme (https) and the
		# visitor's host instead of Caddy's own "http".
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode gzip

	# REST API
	handle /api/* {
		reverse_proxy api:8000
	}

	# WebSockets (live board, step 4). Caddy upgrades the connection automatically;
	# flush_interval -1 sends every message at once.
	handle /ws/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Everything else: the React app
	handle {
		reverse_proxy web:80
	}
}
